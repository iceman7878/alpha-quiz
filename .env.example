# Link do checkout do ALPHA LAUNCH (R$ 67,97).
# Link do checkout da Disrupty — é o único lugar.
# Vazio = o botão de compra leva para /checkout-em-breve.
NEXT_PUBLIC_CHECKOUT_URL=

# ID do Meta Pixel. Vazio = pixel desligado.
NEXT_PUBLIC_META_PIXEL_ID=

# Webhook que recebe o lead do quiz (nome, WhatsApp, e-mail, rota, UTMs).
# Ex.: cenário do Make/Zapier que joga numa planilha ou no ManyChat. Vazio: em dev só loga; em produção sem Supabase o lead responde 503.
LEAD_WEBHOOK_URL=

# ---------- Área de membros (Supabase) ----------
# Sem estas variáveis: modo demonstração em desenvolvimento; em produção, /build fica fechado.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role: SÓ no servidor. Nunca expor com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Webhook do checkout. Fica FECHADO (503) até existirem CHECKOUT_WEBHOOK_SECRET (mín. 32 caracteres) e CHECKOUT_PRODUCT_IDS.
# Token secreto na URL: /api/checkout?token=<valor> (ou no header x-webhook-token). Gere com: openssl rand -hex 32
CHECKOUT_WEBHOOK_SECRET=
# OPCIONAL, só quando a Disrupty documentar o segredo do X-Signature: segredo + header juntos (só um dos dois = 503),
# algoritmo do HMAC do corpo (sha256|sha1). Vazios = sem verificação de assinatura.
CHECKOUT_SIGNATURE_SECRET=
CHECKOUT_SIGNATURE_HEADER=
CHECKOUT_SIGNATURE_ALGO=sha256
# productId do ALPHA LAUNCH na Disrupty (vírgula para mais de um). Nunca o id do order bump. Outro produto não libera acesso.
CHECKOUT_PRODUCT_IDS=

# Domínio final (usado no link do convite por e-mail)
NEXT_PUBLIC_SITE_URL=

# Link da aplicação para a ALPHA Mentorship. Vazio = BUILD 03 vê "ainda não está aberta" e os outros níveis não veem o botão.
NEXT_PUBLIC_MENTORSHIP_URL=

# Modo demonstração: só em `npm run dev` sem Supabase. Não há variável para ligá-lo em build de produção.
