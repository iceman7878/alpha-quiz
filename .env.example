# Link do checkout do ALPHA LAUNCH (R$ 67,97).
# Troque aqui quando a plataforma for definida — é o único lugar.
NEXT_PUBLIC_CHECKOUT_URL=https://checkout.exemplo.com/alpha-launch

# ID do Meta Pixel. Vazio = pixel desligado.
NEXT_PUBLIC_META_PIXEL_ID=

# Webhook que recebe o lead do quiz (nome, WhatsApp, e-mail, rota, UTMs).
# Ex.: cenário do Make/Zapier que joga numa planilha ou no ManyChat. Vazio = só log.
LEAD_WEBHOOK_URL=

# ---------- Área de membros (Supabase) ----------
# Sem estas variáveis, /build roda em modo demonstração (dados só no navegador).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role: SÓ no servidor. Nunca expor com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Token secreto do webhook do checkout: /api/checkout?token=<valor>
CHECKOUT_WEBHOOK_SECRET=

# Domínio final (usado no link do convite por e-mail)
NEXT_PUBLIC_SITE_URL=https://seu-dominio.com.br

# Link da aplicação para a ALPHA Mentorship. Vazio = mostra "abre em breve".
NEXT_PUBLIC_MENTORSHIP_URL=
